APP_NAME="Unnat Technology Services"
APP_URL=http://localhost:8000
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata

MONGODB_URI=<paste MongoDB URI here>
MONGODB_DATABASE=client_leads

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=<generate with php scripts/hash_admin_password.php "your-password">

MAIL_FROM=notifications@example.com
MAIL_FROM_NAME="Unnat Technology Services"

# Generate with: vendor/bin/web-push generate:vapid
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Billing / invoice details printed on bills and receipts
BILLING_NAME="Unnat Technology Services"
BILLING_ADDRESS="Buddhi Vihar, Delhi Road, Moradabad, Uttar Pradesh 244001, India"
BILLING_EMAIL=unnattechnologyservices@gmail.com
BILLING_PHONE="+91 96908 05228"
BILLING_WEBSITE=https://unnattechnologyservices.com
BILLING_CURRENCY_SYMBOL=₹
BILLING_TAX_LABEL=GST
BILLING_TAX_ID=
BILLING_BANK_DETAILS=
BILLING_TERMS="Payment is due within 7 days of the invoice date. Part payments are receipted individually."

# Address clients sign in at, used by the credential share composer
CLIENT_PORTAL_URL=https://clients.unnattechnologyservices.com
