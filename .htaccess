# Unnat Technology Services — public site routing
#
# index.php now renders the homepage; contact.html, sitemap.xml and robots.txt
# keep their public URLs but are produced by PHP so the admin panel can edit them.

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^contact\.html$ contact.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>

ErrorDocument 404 /404.php

# Never serve the local database credentials directly.
<FilesMatch "^(\.env|_conn\.local\.php|_conn\.example\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Compress text responses — CSS, JS and HTML shrink by roughly 70%.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
</IfModule>

# Let the browser reuse assets instead of re-downloading them every page load.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresDefault "access plus 1 day"

  # Pages are generated from the database, so they must never be cached.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
